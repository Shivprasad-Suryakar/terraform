terraform {
  required_version = ">= 1.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = "us-east-1"
}

resource "aws_s3_bucket" "my_bucket" {
  # Note: S3 bucket names must be globally unique across all AWS accounts
  bucket = "osho-rajnish"

  tags = {
    Name        = "My S3 Bucket"
    Environment = "Development"
  }
}
